# Normalización de finales de línea.
# Sin esto, git convierte los scripts a CRLF en Windows y el shebang deja de
# funcionar en Linux y macOS: el hook falla en silencio.
* text=auto eol=lf

# Scripts: LF siempre, sin excepción
*.sh        text eol=lf
.githooks/* text eol=lf
*.bash      text eol=lf

# Archivos que git no debe tocar
*.png  binary
*.jpg  binary
*.pdf  binary
*.gz   binary
*.zip  binary
*.woff binary
*.woff2 binary
