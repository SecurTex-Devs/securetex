#!/usr/bin/env bash
# SecurTex · impide el push directo a la rama protegida.
#
# Sustituto local de la protección de ramas de GitHub, que no está disponible
# en repositorios privados del plan Free. No es infalible (se puede saltar con
# --no-verify), pero evita el 90 % de los accidentes reales: el push a main
# hecho sin darse cuenta.
#
# Instalación, una sola vez por persona y repositorio:
#     git config core.hooksPath .githooks

set -u

RAMA_PROTEGIDA="main"
rojo='\033[0;31m'; amarillo='\033[0;33m'; verde='\033[0;32m'; fin='\033[0m'

while read -r ref_local sha_local ref_remoto sha_remoto; do
  # Borrado de rama remota
  if [ "$sha_local" = "0000000000000000000000000000000000000000" ]; then
    if [ "$ref_remoto" = "refs/heads/$RAMA_PROTEGIDA" ]; then
      printf "${rojo}✕ Estás intentando BORRAR la rama %s.${fin}\n" "$RAMA_PROTEGIDA" >&2
      exit 1
    fi
    continue
  fi

  if [ "$ref_remoto" = "refs/heads/$RAMA_PROTEGIDA" ]; then
    printf "\n${rojo}✕ Push directo a '%s' bloqueado${fin}\n\n" "$RAMA_PROTEGIDA" >&2
    printf "  Los cambios se suben a develop; a main solo llega develop por pull request.\n" >&2
    printf "  Lo tienes en el README.md de la raíz.\n\n" >&2
    printf "  ${verde}Qué hacer ahora:${fin}\n" >&2
    printf "    git switch develop && git merge -  (o git switch -c feat/lo-que-estas-haciendo)\n" >&2
    printf "    git push origin develop\n" >&2
    printf "    gh pr create --fill\n\n" >&2
    printf "  ${amarillo}Si de verdad necesitas saltártelo (y sabes por qué):${fin}\n" >&2
    printf "    git push --no-verify\n\n" >&2
    exit 1
  fi
done

exit 0
