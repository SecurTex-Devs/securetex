# ─────────────────────────────────────────────────────────────────────────────
# SecurTex · variables de entorno de docker-compose.yml
#
#   cp .env.example .env      (rellena los valores y NUNCA subas .env a git)
#   docker compose up --build -d
#
# Cada secreto lleva al lado el comando que lo genera; funciona con OpenSSL
# (incluido en Git Bash en Windows, y en Linux y macOS). Usa un valor distinto
# en cada línea.
#
# ⚠ Una vez creada la base, no cambies las claves: cifran los datos
# guardados y, con otras, no se podrían descifrar.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Propietario de la base (solo lo usan las migraciones) y los tres roles de
# mínimo privilegio con los que se conecta la API.
# Generar cada una: openssl rand -hex 24
POSTGRES_PASSWORD=
DB_IDENTITY_PASSWORD=
DB_APP_PASSWORD=
DB_AUDIT_PASSWORD=

# ── Claves de 32 bytes en base64 ─────────────────────────────────────────────
# Generar cada una: openssl rand -base64 32
# Cifrado en reposo de los secretos TOTP del segundo factor.
MFA_ENCRYPTION_KEY=
# Clave maestra de los archivos (envuelve la clave de cada proyecto con AES-KW).
FILES_MASTER_KEY=
# Clave maestra de las columnas cifradas de la base y de los índices ciegos.
DATA_MASTER_KEY=

# ── Claves privadas (PKCS#8 DER en base64, en una sola línea) ────────────────
# Ed25519 que firma los access tokens.
#   openssl genpkey -algorithm ed25519 -outform DER | openssl base64 -A
JWT_PRIVATE_KEY=
# X25519 del servicio: abre los sobres cifrados que envía el navegador.
#   openssl genpkey -algorithm x25519 -outform DER | openssl base64 -A
TRANSPORT_PRIVATE_KEY=
# Ed25519 que firma los PDF compilados. Nunca entra en el sandbox.
#   openssl genpkey -algorithm ed25519 -outform DER | openssl base64 -A
COMPILER_SIGNING_KEY=

# ── Datos de demostración ────────────────────────────────────────────────────
# Contraseña de las cuentas ana.torres, maria.rodriguez, jorge.cardenas y
# luis.perez @securtex.test (Ana es administradora). Mínimo 12 caracteres.
# Si la dejas vacía, se genera una y aparece en: docker compose logs migrate
SEED_DEMO_PASSWORD=

# Demo pública limitada (requiere ejecutar el seed dedicado; no usa las cuentas académicas).
DEMO_ENABLED=false
# Fuera de Compose, el registro queda cerrado si no se habilita expresamente.
REGISTRATION_ENABLED=false

# ── Opcional ─────────────────────────────────────────────────────────────────
# Comprobación de contraseñas filtradas (HIBP, k-anonimato). Requiere Internet.
HIBP_ENABLED=true

# Uso desde otros equipos de la red local: publica los puertos en todas las
# interfaces y añade la IP del equipo a los orígenes permitidos.
#   PUBLISH_HOST=0.0.0.0
#   APP_ORIGIN=http://192.168.1.50:3000,http://localhost:3000
PUBLISH_HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000

# Inicio de sesión con Google y Microsoft (OIDC, gratuito). URI de redirección:
#   http://localhost:3000/api/v1/auth/oidc/google/callback
#   http://localhost:3000/api/v1/auth/oidc/microsoft/callback
# Los pasos para obtenerlos están en backend/README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=consumers

# Aislamiento del sandbox de LaTeX: runsc (gVisor) donde esté instalado.
COMPILER_RUNTIME=runc
