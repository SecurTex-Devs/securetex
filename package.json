{
  "name": "securtex-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "pnpm api:generate && next build",
    "start": "next start -p 3000",
    "typecheck": "pnpm api:generate && tsc --noEmit",
    "api:sync": "node scripts/api-sync.mjs",
    "api:generate": "openapi-typescript contracts/openapi.json -o src/shared/api/generated.ts",
    "api:check": "node scripts/api-sync.mjs --check"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@tanstack/react-query": "5.104.3",
    "clsx": "2.1.1",
    "dompurify": "3.4.17",
    "fflate": "0.8.3",
    "katex": "0.16.47",
    "lucide-react": "0.577.0",
    "next": "15.5.28",
    "openapi-fetch": "0.17.0",
    "pdfjs-dist": "4.10.38",
    "radix-ui": "1.8.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tailwind-merge": "3.7.0",
    "y-codemirror.next": "0.3.6",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/katex": "0.16.7",
    "@types/node": "22.20.5",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
