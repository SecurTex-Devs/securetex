{
  "name": "@securtex/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de SecurTex · identidad, sesiones, MFA, auditoría y proyectos (Sprint 1)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:security": "node --test \"test/security/*.test.mjs\"",
    "contracts:generate": "node dist/scripts/generate-openapi.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node dist/scripts/seed.js",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.6",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "fastify": "5.11.3",
    "jose": "6.2.12",
    "nodemailer": "7.0.13",
    "openid-client": "6.8.8",
    "otplib": "12.0.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.12",
    "@types/qrcode": "1.5.6",
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
